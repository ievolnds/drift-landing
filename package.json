{
  "name": "drift-marketing-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "build:static": "GITHUB_PAGES=true NEXT_PUBLIC_BASE_PATH=/drift-landing NEXT_PUBLIC_SITE_URL=https://ievolnds.github.io/drift-landing next build --webpack",
    "start": "next start",
    "test": "npm run build:static && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern out --ignore-pattern .vercel --ignore-pattern dist"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "sharp": "0.34.5",
    "typescript": "5.9.3"
  },
  "type": "module"
}
